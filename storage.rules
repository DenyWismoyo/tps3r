rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true || request.auth.token.email != null);
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Foto katalog produk TPS 3R: publik dapat melihat, hanya pengurus dapat upload/hapus
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Aset laporan / dokumentasi kegiatan TPS 3R
    match /reports/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Default deny untuk path lainnya
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
